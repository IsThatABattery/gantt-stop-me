# Copy to .env to override the dev defaults in docker-compose.yml.

# Base URL users open. The API accepts writes only from this origin.
# Keep http://localhost:8080 for `npm run dev` too: Vite's proxy sends that origin on /api writes.
PUBLIC_URL=http://localhost:8080

# Postgres connection string for api.
DATABASE_URL=postgres://gantt:gantt@db:5432/gantt?sslmode=disable

# 32 random bytes, base64. Encrypts stored credentials. Generate: openssl rand -base64 32
# Required once this file is copied: the API will not start while it is blank.
ENCRYPTION_KEY=

# GitHub OAuth App that links accounts. Create one at https://github.com/settings/developers
# with the authorization callback URL {PUBLIC_URL}/api/github/callback,
# e.g. http://localhost:8080/api/github/callback. The app asks for the repo scope.
# Leave both empty to link with personal access tokens only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Set to true to let provider base URLs reach loopback and private addresses, such as a local Ollama.
ALLOW_PRIVATE_PROVIDER_URLS=

# The runner's base URL, for api. Defaults to the runner service, http://runner:8081.
# To keep test containers off this machine, run the runner service on a spare VM with its own Docker,
# point this at it, and let only the API reach the VM's port 8081.
RUNNER_URL=

# Shared bearer token between api and the runner. 32 random bytes, base64. Generate: openssl rand -base64 32
# Required once this file is copied: the runner will not start while it is blank.
RUNNER_TOKEN=

# Workflow executions running at once across the install. Default 1.
MAX_CONCURRENT_WORKFLOWS=

# Prefix for every image, container, network and volume the runner makes. Default gantt.
# 2 to 32 lowercase letters, digits or -, starting with a letter and ending in a letter or digit.
# Give each install on a shared Docker daemon its own.
RUN_PREFIX=
