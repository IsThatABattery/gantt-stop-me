# Copy to .env to override the dev defaults in docker-compose.yml.

# Base URL users open. The API accepts writes only from this origin.
PUBLIC_URL=http://localhost:8080

# Postgres connection string for api.
DATABASE_URL=postgres://gantt:gantt@db:5432/gantt?sslmode=disable

# 32 random bytes, base64. Encrypts stored credentials. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
