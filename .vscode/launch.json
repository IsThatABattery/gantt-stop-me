{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DB",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose -f docker-compose.yml -f .devcontainer/docker-compose.yml logs -f db",
      "preLaunchTask": "db: start",
      "postDebugTask": "db: stop"
    },
    {
      "name": "API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src/back/api/cmd/api",
      "preLaunchTask": "db: start"
    },
    {
      "name": "Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --strictPort",
      "cwd": "${workspaceFolder}/src/front",
      "serverReadyAction": {
        "pattern": "Local:",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      }
    },
    {
      "name": "Web (Chrome debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --strictPort",
      "cwd": "${workspaceFolder}/src/front",
      "serverReadyAction": {
        "pattern": "Local:",
        "uriFormat": "http://localhost:5173",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}/src/front"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["DB", "API", "Web"],
      "preLaunchTask": "db: start",
      "stopAll": true
    }
  ]
}
